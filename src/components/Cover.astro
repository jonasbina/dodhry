---
// Plakátové obálky her v zemité paletě – ploché tvary, žádné obrázky ke stahování.
interface Props { game: string; class?: string }
const { game, class: cls = '' } = Astro.props;

// deterministický generátor, ať obálka vypadá pokaždé stejně
const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const uid = `c-${game}-${Math.floor(Math.random() * 1e6)}`;

let horde: { x: number; y: number; r: number }[] = [];
if (game === 'horde-survivor') {
  const r = rng(11);
  for (let ring = 0; ring < 5; ring++) {
    const count = 10 + ring * 7, dist = 52 + ring * 30;
    for (let i = 0; i < count; i++) {
      const a = (i / count) * Math.PI * 2 + ring * 0.4 + r() * 0.2;
      horde.push({ x: 200 + Math.cos(a) * dist * 1.25, y: 150 + Math.sin(a) * dist * 0.9, r: 4 + r() * 3 + ring * 0.6 });
    }
  }
}
---
<div class:list={['cover', cls]} aria-hidden="true">
  {game === 'nocni-velka-cena' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#2b1916" />
      <circle cx="318" cy="70" r="26" fill="#ddbe78" opacity=".9" />
      {[0, 1, 2, 3, 4].map((i) => (
        <g>
          <rect x={92 + i * 46} y="118" width="34" height="34" rx="17" fill="#39221e" />
          <circle cx={109 + i * 46} cy="135" r="11" fill={i < 3 ? '#ddaa61' : '#4a2c26'} />
        </g>
      ))}
      <path d="M-10 250 C 90 196, 250 196, 410 232 L410 300 L-10 300Z" fill="#4a4741" />
      <path d="M-10 262 C 90 210, 250 210, 410 246" stroke="#f7f1e8" stroke-width="2" stroke-dasharray="14 12" fill="none" opacity=".55" />
      <path d="M170 236 h70 l16 -10 h30 l10 8 v8 h-126z" fill="#af751b" />
      <circle cx="194" cy="246" r="9" fill="#1c1b1a" /><circle cx="272" cy="244" r="9" fill="#1c1b1a" />
    </svg>
  )}
  {game === 'horde-survivor' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#6b443d" />
      <ellipse cx="200" cy="150" rx="70" ry="52" fill="#7d5047" />
      {horde.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill="#39221e" />)}
      <circle cx="200" cy="150" r="34" fill="none" stroke="#ddbe78" stroke-width="1.5" stroke-dasharray="2 7" />
      <circle cx="200" cy="150" r="12" fill="#ddbe78" />
      <path d="M212 146 L268 118 M190 158 L142 184" stroke="#ddbe78" stroke-width="2" stroke-linecap="round" opacity=".8" />
    </svg>
  )}
  {game === 'stadium-defense' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#5c6f5d" />
      <ellipse cx="200" cy="155" rx="176" ry="106" fill="#a0573f" />
      {[0, 1, 2, 3, 4].map((i) => (
        <ellipse cx="200" cy="155" rx={170 - i * 11} ry={100 - i * 9} fill="none" stroke="#f7f1e8" stroke-opacity=".45" />
      ))}
      <ellipse cx="200" cy="155" rx="112" ry="52" fill="#849671" />
      <path d="M200 103 V207" stroke="#ced4b8" stroke-opacity=".5" />
      <g transform="translate(200 150)">
        <path d="M-20 -26 h40 v10 c0 18 -10 27 -20 27 c-10 0 -20 -9 -20 -27z" fill="#ddaa61" />
        <path d="M-20 -19 c-13 0 -13 17 3 17 M20 -19 c13 0 13 17 -3 17" stroke="#ddaa61" stroke-width="4" fill="none" />
        <rect x="-5" y="11" width="10" height="9" fill="#af751b" /><rect x="-15" y="20" width="30" height="7" rx="2" fill="#684d07" />
      </g>
    </svg>
  )}
  {game === 'halovy-kros' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#bc924c" />
      <circle cx="80" cy="64" r="34" fill="#ddbe78" />
      <path d="M-10 230 Q 70 228 112 180 Q 140 150 168 228 Q 236 230 286 168 Q 320 128 410 226 L410 300 L-10 300Z" fill="#6b443d" />
      <path d="M-10 262 Q 120 250 200 270 Q 300 290 410 262 L410 300 L-10 300Z" fill="#39221e" />
      <path d="M128 150 Q 190 70 262 128" stroke="#39221e" stroke-width="2" stroke-dasharray="3 7" fill="none" />
      <g transform="translate(206 96) rotate(-18)">
        <circle cx="-26" cy="20" r="15" fill="none" stroke="#1c1b1a" stroke-width="6" />
        <circle cx="28" cy="20" r="15" fill="none" stroke="#1c1b1a" stroke-width="6" />
        <path d="M-26 20 L0 2 L28 20 M0 2 L-7 -7 h21 l12 12" stroke="#f7f1e8" stroke-width="6" fill="none" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx="2" cy="-30" r="7" fill="#1c1b1a" />
        <path d="M-3 -8 l-3 -16 l11 -2 l6 15" fill="#1c1b1a" />
      </g>
    </svg>
  )}
</div>

<style>
  .cover { position: relative; overflow: hidden; background: var(--canvas-deep); }
  .cover svg { width: 100%; height: 100%; }
</style>
