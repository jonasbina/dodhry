---
// Plakátové obálky her v zemité paletě – ploché tvary, žádné obrázky ke stahování.
interface Props { game: string; class?: string }
const { game, class: cls = '' } = Astro.props;

// deterministický generátor, ať obálka vypadá pokaždé stejně
const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const uid = `c-${game}-${Math.floor(Math.random() * 1e6)}`;

let horde: { x: number; y: number; r: number }[] = [];
if (game === 'horde-survivor') {
  const r = rng(11);
  for (let ring = 0; ring < 5; ring++) {
    const count = 10 + ring * 7, dist = 52 + ring * 30;
    for (let i = 0; i < count; i++) {
      const a = (i / count) * Math.PI * 2 + ring * 0.4 + r() * 0.2;
      horde.push({ x: 200 + Math.cos(a) * dist * 1.25, y: 150 + Math.sin(a) * dist * 0.9, r: 4 + r() * 3 + ring * 0.6 });
    }
  }
}
---
<div class:list={['cover', cls]} aria-hidden="true">
  {game === 'nocni-velka-cena' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#2b1916" />
      <circle cx="318" cy="70" r="26" fill="#ddbe78" opacity=".9" />
      {[0, 1, 2, 3, 4].map((i) => (
        <g>
          <rect x={92 + i * 46} y="118" width="34" height="34" rx="17" fill="#39221e" />
          <circle cx={109 + i * 46} cy="135" r="11" fill={i < 3 ? '#ddaa61' : '#4a2c26'} />
        </g>
      ))}
      <path d="M-10 250 C 90 196, 250 196, 410 232 L410 300 L-10 300Z" fill="#4a4741" />
      <path d="M-10 262 C 90 210, 250 210, 410 246" stroke="#f7f1e8" stroke-width="2" stroke-dasharray="14 12" fill="none" opacity=".55" />
      <path d="M170 236 h70 l16 -10 h30 l10 8 v8 h-126z" fill="#af751b" />
      <circle cx="194" cy="246" r="9" fill="#1c1b1a" /><circle cx="272" cy="244" r="9" fill="#1c1b1a" />
    </svg>
  )}
  {game === 'horde-survivor' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#6b443d" />
      <ellipse cx="200" cy="150" rx="70" ry="52" fill="#7d5047" />
      {horde.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill="#39221e" />)}
      <circle cx="200" cy="150" r="34" fill="none" stroke="#ddbe78" stroke-width="1.5" stroke-dasharray="2 7" />
      <circle cx="200" cy="150" r="12" fill="#ddbe78" />
      <path d="M212 146 L268 118 M190 158 L142 184" stroke="#ddbe78" stroke-width="2" stroke-linecap="round" opacity=".8" />
    </svg>
  )}
  {game === 'stadium-defense' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#5c6f5d" />
      <ellipse cx="200" cy="155" rx="176" ry="106" fill="#a0573f" />
      {[0, 1, 2, 3, 4].map((i) => (
        <ellipse cx="200" cy="155" rx={170 - i * 11} ry={100 - i * 9} fill="none" stroke="#f7f1e8" stroke-opacity=".45" />
      ))}
      <ellipse cx="200" cy="155" rx="112" ry="52" fill="#849671" />
      <path d="M200 103 V207" stroke="#ced4b8" stroke-opacity=".5" />
      <g transform="translate(200 150)">
        <path d="M-20 -26 h40 v10 c0 18 -10 27 -20 27 c-10 0 -20 -9 -20 -27z" fill="#ddaa61" />
        <path d="M-20 -19 c-13 0 -13 17 3 17 M20 -19 c13 0 13 17 -3 17" stroke="#ddaa61" stroke-width="4" fill="none" />
        <rect x="-5" y="11" width="10" height="9" fill="#af751b" /><rect x="-15" y="20" width="30" height="7" rx="2" fill="#684d07" />
      </g>
    </svg>
  )}
  {game === 'bily-kopec' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#ced4b8" />
      <circle cx="320" cy="58" r="24" fill="#f7f1e8" />
      <path d="M-10 230 L110 70 L170 140 L240 40 L410 250 L410 300 L-10 300Z" fill="#f7f1e8" />
      <path d="M110 70 L130 120 L118 150 L150 118 L170 140 Z M240 40 L250 110 L232 160 L275 95 Z" fill="#e1dcd3" />
      <path d="M232 52 C 214 110, 262 150, 236 222" stroke="#2a72de" stroke-width="7" fill="none" stroke-linecap="round" opacity=".55" />
      <path d="M118 84 C 100 140, 150 170, 128 240" stroke="#6b443d" stroke-width="7" fill="none" stroke-linecap="round" opacity=".55" />
      <path d="M60 268 L242 46" stroke="#39221e" stroke-width="1.5" />
      {[0.22, 0.45, 0.68].map((t) => (
        <g transform={`translate(${60 + (242 - 60) * t} ${268 + (46 - 268) * t})`}>
          <path d="M0 0 V8" stroke="#39221e" stroke-width="1.5" />
          <rect x="-7" y="8" width="14" height="10" rx="3" fill="#af751b" />
        </g>
      ))}
      {[[20, 250], [40, 262], [300, 240], [326, 258], [352, 236], [372, 262], [70, 282], [280, 280]].map(([x, y]) => (
        <path d={`M${x} ${y - 30} L${x + 13} ${y} L${x - 13} ${y}Z`} fill="#224228" />
      ))}
    </svg>
  )}
  {game === 'kaktus' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#ddaa61" />
      <circle cx="200" cy="150" r="70" fill="#f0c97c" />
      <path d="M-10 196 h70 v-40 h60 v40 h40 L170 196 L-10 196Z M250 196 v-58 h44 v-22 h50 v80Z" fill="#a0573f" />
      <rect x="-10" y="196" width="420" height="110" fill="#bc924c" />
      <path d="M-10 230 Q 100 220 200 236 Q 300 252 410 232 L410 300 L-10 300Z" fill="#af751b" />
      <g transform="translate(200 232)">
        <rect x="-16" y="-110" width="32" height="112" rx="16" fill="#5c6f5d" />
        <path d="M-16 -50 h-22 a10 10 0 0 1 -10 -10 v-30 a10 10 0 0 1 20 0 v20 h12" fill="#5c6f5d" />
        <path d="M16 -70 h22 a10 10 0 0 0 10 -10 v-24 a10 10 0 0 0 -20 0 v14 h-12" fill="#5c6f5d" />
        <path d="M-34 -110 h68 l-8 -6 h-12 l-6 -18 h-16 l-6 18 h-12z" fill="#39221e" />
        <circle cx="-6" cy="-92" r="3" fill="#1c1b1a" /><circle cx="7" cy="-92" r="3" fill="#1c1b1a" />
        <path d="M-8 -82 q8 5 16 0" stroke="#1c1b1a" stroke-width="2.5" fill="none" stroke-linecap="round" />
        {[-70, -40, -10].map((y) => <path d={`M-16 ${y} l-6 -3 M16 ${y + 12} l6 -3`} stroke="#ced4b8" stroke-width="2" />)}
      </g>
    </svg>
  )}
  {game === 'lovec-z-hurecka' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#7b886d" />
      <rect y="0" width="400" height="150" fill="#a9b39a" />
      {[[-20, 150, 70], [40, 150, 90], [300, 150, 80], [360, 150, 100], [150, 150, 60]].map(([x, y, h]) => (
        <path d={`M${x} ${y} L${x + 30} ${y - h} L${x + 60} ${y}Z`} fill="#5c6f5d" opacity=".7" />
      ))}
      <rect y="150" width="400" height="150" fill="#5c6f5d" />
      <g fill="#39221e">
        {Array.from({ length: 26 }, (_, i) => <path d={`M${i * 16} 214 v-34 l7 -9 l7 9 v34z`} />)}
      </g>
      <path d="M140 150 h70 v40 h-70z" fill="#6b443d" /><path d="M130 152 L175 118 L220 152Z" fill="#4a4741" />
      <rect x="168" y="168" width="14" height="22" fill="#ddaa61" />
      <path d="M232 160 h52 v32 h-52z" fill="#6b443d" /><path d="M224 162 L258 136 L292 162Z" fill="#4a4741" />
      <rect x="250" y="172" width="10" height="10" fill="#ddaa61" />
      <path d="M0 236 Q 200 220 400 240 L400 300 L0 300Z" fill="#4a5a45" />
      <rect y="120" width="400" height="60" fill="#f7f1e8" opacity=".18" />
      <path d="M90 250 l10 -40 l4 0 l-6 40z" fill="#1c1b1a" /><circle cx="103" cy="204" r="6" fill="#1c1b1a" />
    </svg>
  )}
  {game === 'holubi-bombardovani' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#ddbe78" />
      <circle cx="330" cy="62" r="26" fill="#f7f1e8" />
      {[[10, 120, 60], [76, 90, 48], [130, 140, 56], [192, 70, 64], [262, 110, 52], [320, 130, 90]].map(([x, h, w]) => (
        <rect x={x} y={300 - 80 - h} width={w} height={h + 80} fill="#bc924c" />
      ))}
      {[[24, 130], [40, 150], [90, 116], [206, 98], [224, 128], [276, 140], [336, 150], [356, 176]].map(([x, y]) => (
        <rect x={x} y={y} width="8" height="12" fill="#f7f1e8" opacity=".55" />
      ))}
      <rect y="250" width="400" height="50" fill="#4a4741" />
      <path d="M0 258 h400" stroke="#ddbe78" stroke-width="2" stroke-dasharray="18 14" />
      <g transform="translate(150 70)">
        <ellipse cx="0" cy="0" rx="30" ry="16" fill="#849671" />
        <path d="M-8 -4 L-36 -30 L10 -8Z" fill="#5c6f5d" />
        <circle cx="26" cy="-8" r="11" fill="#5c6f5d" /><circle cx="29" cy="-10" r="2.5" fill="#1c1b1a" />
        <path d="M36 -7 l9 3 l-9 2z" fill="#af751b" />
        <path d="M-30 2 l-16 6 l16 4z" fill="#5c6f5d" />
      </g>
      {[[140, 112], [143, 146], [146, 184]].map(([x, y]) => <ellipse cx={x} cy={y} rx="5" ry="6" fill="#f7f1e8" />)}
      <g transform="translate(150 250)">
        <circle cx="0" cy="-44" r="9" fill="#39221e" /><rect x="-8" y="-36" width="16" height="26" rx="5" fill="#6b443d" />
        <path d="M-5 -10 l-4 10 M5 -10 l4 10" stroke="#39221e" stroke-width="5" stroke-linecap="round" />
        <ellipse cx="2" cy="-52" rx="6" ry="4" fill="#f7f1e8" />
      </g>
    </svg>
  )}
  {game === 'halovy-kros' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#bc924c" />
      <circle cx="80" cy="64" r="34" fill="#ddbe78" />
      <path d="M-10 230 Q 70 228 112 180 Q 140 150 168 228 Q 236 230 286 168 Q 320 128 410 226 L410 300 L-10 300Z" fill="#6b443d" />
      <path d="M-10 262 Q 120 250 200 270 Q 300 290 410 262 L410 300 L-10 300Z" fill="#39221e" />
      <path d="M128 150 Q 190 70 262 128" stroke="#39221e" stroke-width="2" stroke-dasharray="3 7" fill="none" />
      <g transform="translate(206 96) rotate(-18)">
        <circle cx="-26" cy="20" r="15" fill="none" stroke="#1c1b1a" stroke-width="6" />
        <circle cx="28" cy="20" r="15" fill="none" stroke="#1c1b1a" stroke-width="6" />
        <path d="M-26 20 L0 2 L28 20 M0 2 L-7 -7 h21 l12 12" stroke="#f7f1e8" stroke-width="6" fill="none" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx="2" cy="-30" r="7" fill="#1c1b1a" />
        <path d="M-3 -8 l-3 -16 l11 -2 l6 15" fill="#1c1b1a" />
      </g>
    </svg>
  )}
</div>

<style>
  .cover { position: relative; overflow: hidden; background: var(--canvas-deep); }
  .cover svg { width: 100%; height: 100%; }
</style>
