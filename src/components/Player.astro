---
// Přehrávač hry: celá obrazovka, nahoře tenká tmavá lišta, která splývá s hrou.
import { GAMES, MINUTE_CAP } from '../lib/games';
interface Props { gameId?: string }
const { gameId } = Astro.props;
const start = gameId ? GAMES.find((g) => g.id === gameId) : undefined;
---
<section class="player" id="player" hidden={!start} aria-label="Hra" data-start={start?.id}>
  <header class="pbar">
    <a class="pb-btn" id="pBack" href="/">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Hry
    </a>
    <span class="pb-title" id="pTitle">{start?.title}</span>
    <span class="pb-sep" aria-hidden="true"></span>
    <span class="pb-earned num" id="pEarned" title="Body získané teď v této hře">+0</span>
    <span class="pb-total num"><b id="pPts">0</b> / <span id="pTarget">100</span> b</span>
    <button class="pb-btn" id="pRulesBtn" type="button" aria-expanded="false" aria-controls="pRules">Za co body?</button>
    <button class="pb-btn pb-icon" id="pFs" type="button" title="Celá obrazovka (F)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
      <span class="sr-only">Celá obrazovka</span>
    </button>
  </header>

  {GAMES.map((g) => (
    <aside class="rules" data-rules={g.id} hidden aria-label={`Body ve hře ${g.title}`}>
      <p class="r-lead">{g.rule}</p>
      <table class="r-table"><tbody>
        {g.howTo.map(([what, pts]) => <tr><td>{what}</td><td class="num">{pts}</td></tr>)}
        <tr class="r-extra"><td>Každá minuta hraní</td><td class="num">+1 b (max {MINUTE_CAP})</td></tr>
      </tbody></table>
      <p class="r-finish">{g.finish}</p>
      <p class="r-controls">Ovládání: {g.controls}</p>
    </aside>
  ))}

  <div class="intro" id="pIntro" hidden={!start}>
    <button class="btn btn-primary" id="pStart" type="button">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
      Spustit na celou obrazovku
    </button>
  </div>

  <iframe id="pFrame" title="Hra" allow="fullscreen; autoplay; gamepad"></iframe>
</section>

<style>
  .player { position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column; background: #000; color: #f3f1ec; }
  .pbar {
    display: flex; align-items: center; gap: 6px; flex: none; height: 40px;
    padding: 0 max(8px, env(safe-area-inset-right, 0px)) 0 max(8px, env(safe-area-inset-left, 0px));
    background: #121214; border-bottom: 1px solid #26262a; font-size: 0.875rem;
  }
  .pb-btn {
    display: inline-flex; align-items: center; gap: 4px; height: 30px; padding: 0 10px; border-radius: 999px;
    border: 0; background: transparent; color: #d8d5cf; text-decoration: none; font-size: 0.875rem; font-weight: 500;
  }
  .pb-btn:hover, .pb-btn[aria-expanded='true'] { background: #26262a; color: #fff; }
  .pb-btn svg { width: 16px; height: 16px; }
  .pb-icon { width: 30px; padding: 0; justify-content: center; }
  .pb-title { font-weight: 600; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; padding-left: 4px; }
  .pb-sep { flex: 1; }
  .pb-earned { color: var(--gold-soft); font-weight: 600; padding: 0 6px; }
  .pb-total { color: #a8a5a0; padding: 0 6px; white-space: nowrap; }
  .pb-total b { color: #fff; font-weight: 600; }
  .rules {
    position: absolute; z-index: 3; top: 46px; right: 8px; width: min(360px, calc(100% - 16px));
    padding: 16px 18px; border-radius: var(--r-md); background: #1c1c20; border: 1px solid #2e2e33;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5); display: grid; gap: 10px; font-size: 0.9375rem;
  }
  .rules p { margin: 0; }
  .r-lead { font-weight: 600; color: #fff; }
  .r-table { width: 100%; border-collapse: collapse; }
  .r-table td { padding: 6px 0; border-top: 1px solid #2e2e33; color: #d8d5cf; }
  .r-table td:last-child { text-align: right; color: var(--gold-soft); font-weight: 600; white-space: nowrap; padding-left: 12px; }
  .r-extra td { color: #a8a5a0; }
  .r-finish { color: #fff; background: #26262a; padding: 8px 10px; border-radius: var(--r-sm); }
  .r-controls { color: #a8a5a0; font-size: 0.875rem; }
  .intro { position: absolute; inset: 40px 0 0; z-index: 2; display: grid; place-items: center; background: rgba(0, 0, 0, 0.6); }
  iframe { flex: 1; width: 100%; border: 0; background: #000; }
  @media (max-width: 640px) { .pb-total, .pb-title { display: none; } .pb-sep { flex: 1; } }
</style>
