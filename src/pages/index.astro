---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Ring from '../components/Ring.astro';
import Cover from '../components/Cover.astro';
import Player from '../components/Player.astro';
import { GAMES, MINUTE_CAP } from '../lib/games';
---
<Base>
  <!-- ================= PŘIHLÁŠENÍ ================= -->
  <div class="when-out">
    <header class="wrap login-top">
      <span class="wordmark-lg" data-title>DOD hry</span>
    </header>

    <main class="wrap login">
      <section class="login-intro">
        <p class="eyebrow">Den otevřených dveří</p>
        <h1 class="display">Zahraj si hry našich&nbsp;studentů.</h1>
        <p class="lead">Za každou dohranou hru dostaneš body. Nasbírej <span data-target>100</span> a máš splněno.</p>
      </section>

      <section class="login-card" aria-labelledby="loginH">
        <form id="nameForm" novalidate>
          <h2 class="h3" id="loginH">Jak ti máme říkat?</h2>
          <p class="caption">Stačí přezdívka, heslo nepotřebuješ. Na jiném počítači se přihlásíš stejným jménem.</p>
          <p class="hint bye" id="bye" hidden></p>
          <div class="field">
            <label for="nameInput">Přezdívka</label>
            <input class="input" id="nameInput" autocomplete="off" autocapitalize="words" spellcheck="false" maxlength="24" placeholder="Třeba Tomáš z 9.B" aria-describedby="nameHint" />
            <p class="hint" id="nameHint" aria-live="polite"></p>
          </div>
          <div class="chips" id="suggest" hidden></div>
          <button class="btn btn-primary btn-block" type="submit" id="nameGo">Pokračovat</button>
        </form>

        <div id="conflict" hidden>
          <h2 class="h3">„<span id="cName"></span>“ už tu někdo hraje</h2>
          <p class="caption">Jsi to ty z jiného počítače, nebo jsi tu poprvé?</p>
          <div class="who">
            <Ring size={56} stroke={4} id="cRing" label="Body hráče"><span class="who-pts num" data-ring-value>0</span></Ring>
            <div><b id="cName2"></b><div class="caption"><span id="cPts">0</span> bodů</div></div>
          </div>
          <div class="stack">
            <button class="btn btn-primary btn-block" id="cMe" type="button">Ano, to jsem já</button>
            <button class="btn btn-outline btn-block" id="cNew" type="button">Jsem tu poprvé</button>
          </div>
        </div>
      </section>
    </main>

    <section class="wrap login-games" aria-label="Hry na portálu">
      {GAMES.map((g) => (
        <figure class="mini">
          <Cover game={g.id} class="mini-cover" />
          <figcaption><b>{g.title}</b><span class="caption">{g.author}</span></figcaption>
        </figure>
      ))}
    </section>
  </div>

  <!-- ================= PŘEHLED ================= -->
  <div class="when-in">
    <Nav />
    <main class="wrap home">
      <section class="summary" aria-labelledby="sumH">
        <Ring size={112} stroke={8} id="bigRing" label="Body k cíli">
          <span class="big-pts num" data-ring-value>0</span>
          <span class="big-of">z <span data-target>100</span></span>
        </Ring>
        <div class="summary-text">
          <h1 class="h1" id="sumH"><span id="sumHead">Ještě 100 bodů do cíle</span></h1>
          <p class="caption" id="sumLead">Body dostaneš za každou dohranou hru a za čas strávený hraním.</p>
          <a class="btn btn-primary btn-sm" id="nextGame" href="/hra/nocni-velka-cena/" data-play="nocni-velka-cena">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
            <span id="nextLabel">Hrát</span>
          </a>
        </div>
        <ul class="breakdown" aria-label="Tvoje body podle her">
          {GAMES.map((g) => (
            <li data-break={g.id}>
              <span class="b-name">{g.title}</span>
              <span class="b-val num">0</span>
              <span class="b-track"><span class="b-fill" style={`background:${g.tone}`}></span></span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="gamesH">
        <div class="section-head">
          <h2 class="h2" id="gamesH">Hry</h2>
          <p class="caption">Hra se spustí přes celou obrazovku. Navíc ke každé hře +1 bod za minutu hraní (nejvýš {MINUTE_CAP}).</p>
        </div>
        <div class="game-grid">
          {GAMES.map((g) => (
            <article class="game" data-game={g.id}>
              <a class="game-link" href={`/hra/${g.id}/`} data-play={g.id} aria-label={`Hrát ${g.title}`}>
                <Cover game={g.id} class="game-cover" />
              </a>
              <div class="game-body">
                <div class="game-head">
                  <h3 class="h2">{g.title}</h3>
                  <p class="caption">{g.author} · {g.group} · {g.genre}</p>
                </div>
                <p class="game-rule">{g.rule}</p>
                <table class="pts-table" aria-label={`Body ve hře ${g.title}`}><tbody>
                  {g.howTo.map(([what, pts]) => <tr><td>{what}</td><td class="num">{pts}</td></tr>)}
                </tbody></table>
                <p class="finish">{g.finish}</p>
                <div class="game-foot">
                  <span class="mine num" data-mine>Zatím 0 b</span>
                  <a class="btn btn-secondary btn-sm" href={`/hra/${g.id}/`} data-play={g.id}>Hrát</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="band">
      <div class="wrap how">
        <div><h3>Střídáš počítač?</h3><p>Nahoře klikni na Odhlásit a na jiném počítači napiš stejnou přezdívku. Body ti zůstanou.</p></div>
        <div><h3>Body se nepřipsaly?</h3><p>Hru musíš dohrát nebo ukončit, a musí trvat aspoň 40 sekund. Co přesně ukončí hru, je u každé hry výš.</p></div>
        <div><h3>Splněno?</h3><p>Když kruh nahoře zezelená, ukaž obrazovku u stolu organizátorů.</p></div>
      </div>
    </footer>
    <Player />
  </div>
</Base>

<style>
  html[data-auth='out'] .when-in, html[data-auth='in'] .when-out { display: none; }

  /* ---------- přihlášení ---------- */
  .login-top { padding-top: calc(20px + env(safe-area-inset-top, 0px)); }
  .wordmark-lg { font: 700 1.25rem/1 var(--sans); letter-spacing: -0.01em; color: var(--stone); }
  .login { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, 440px); gap: 32px 56px; align-items: center; padding-block: 40px 40px; }
  .login-intro { display: grid; gap: 14px; }
  .login-card { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); padding: 24px; }
  .login-card form, #conflict { display: grid; gap: 14px; }
  .login-card .caption { margin: -8px 0 0; }
  .bye { margin: 0; padding: 12px 16px; border-radius: var(--r-md); background: var(--canvas); color: var(--stone); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: -6px; }
  .chips :global(.chip) { min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--stone); background: transparent; color: var(--stone); font-size: 0.9375rem; }
  .chips :global(.chip:hover) { background: var(--canvas); }
  .who { display: flex; align-items: center; gap: 16px; padding: 14px 16px; border-radius: var(--r-md); background: var(--canvas); }
  .who-pts { font: 600 0.9375rem/1 var(--sans); }
  .stack { display: grid; gap: 10px; }
  .login-games { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-bottom: 40px; }
  .mini { margin: 0; display: grid; gap: 12px; }
  .mini :global(.mini-cover) { aspect-ratio: 16 / 10; border-radius: var(--r-md); }
  .mini figcaption { display: grid; gap: 2px; font-size: 0.9375rem; }

  /* ---------- přehled ---------- */
  .home { display: grid; gap: 32px; padding-block: 24px 48px; }
  .summary {
    display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(240px, 300px); gap: 24px 32px; align-items: center;
    padding: 20px 24px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg);
  }
  .summary-text { display: grid; gap: 8px; justify-items: start; }
  .summary-text .caption { margin: 0; }
  .summary-text .btn { margin-top: 6px; }
  .big-pts { display: block; font: 700 2rem/1 var(--sans); letter-spacing: -0.02em; }
  .big-of { display: block; margin-top: 2px; font-size: 0.8125rem; color: var(--muted); }
  .breakdown { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .breakdown li { display: grid; grid-template-columns: 1fr auto; gap: 3px 12px; font-size: 0.875rem; }
  .b-name { color: var(--stone); }
  .b-val { font-weight: 600; }
  .b-track { grid-column: 1 / -1; height: 4px; border-radius: 4px; background: var(--hairline); overflow: hidden; }
  .b-fill { display: block; height: 100%; width: 0; border-radius: inherit; transition: width 0.9s cubic-bezier(0.2, 0.8, 0.2, 1); }

  .section-head { display: flex; align-items: baseline; gap: 6px 16px; flex-wrap: wrap; margin-bottom: 16px; }
  .section-head .caption { margin: 0; }
  .game-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .game { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-lg); overflow: hidden; }
  .game-link { display: block; }
  .game :global(.game-cover) { aspect-ratio: 16 / 10; }
  .game :global(.game-cover svg) { transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .game-link:hover :global(.game-cover svg) { transform: scale(1.04); }
  .game-body { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px 16px; flex: 1; }
  .game-head .caption { margin: 2px 0 0; }
  .game-rule { margin: 0; font-size: 0.9375rem; color: var(--stone); }
  .pts-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .pts-table td { padding: 5px 0; border-top: 1px solid var(--hairline); color: var(--stone); }
  .pts-table td:last-child { text-align: right; font-weight: 650; color: var(--ink); white-space: nowrap; padding-left: 8px; }
  .finish { margin: 0; font-size: 0.8125rem; color: var(--muted); }
  .game-foot { margin-top: auto; padding-top: 6px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .mine { font-size: 0.875rem; font-weight: 600; color: var(--muted); }
  .mine.has { color: var(--gold); }

  .band { background: var(--ink-band-soft); color: #fff; padding-block: 32px calc(32px + env(safe-area-inset-bottom, 0px)); }
  .how { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .how h3 { font: 600 1rem/1.3 var(--sans); margin: 0 0 4px; }
  .how p { margin: 0; color: var(--mute-on-dark); font-size: 0.9375rem; max-width: 40ch; }

  @media (max-width: 960px) {
    .login { grid-template-columns: 1fr; padding-block: 24px 32px; }
    .login-games { grid-template-columns: repeat(2, 1fr); }
    .summary { grid-template-columns: auto minmax(0, 1fr); }
    .breakdown { grid-column: 1 / -1; }
    .how { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 480px) {
    .summary { grid-template-columns: 1fr; justify-items: start; padding: 16px; }
  }
</style>

<script>
  import { GAMES } from '../lib/games';
  import { getPlayer, createPlayer, nameKey, cleanName, watchSettings, type Player, type Settings } from '../lib/db';
  import { getSession, setSession, requirePlayer } from '../lib/session';
  import { isBadName } from '../lib/badnames';
  import { initPlayer, openGame, updatePlayer } from '../lib/player';
  import { fillNav } from '../lib/nav';
  import { $, esc, fmt, bodu, setRing } from '../lib/ui';

  let target = 100;
  const fillTarget = (s: Settings) => {
    target = Number(s.target) || 100;
    document.querySelectorAll('[data-target]').forEach((el) => (el.textContent = fmt(target)));
    document.querySelectorAll('[data-title]').forEach((el) => (el.textContent = s.title));
    document.title = s.title;
  };

  if (getSession()) {
    requirePlayer((me, s) => { fillTarget(s); fillNav(me, s); render(me, s); updatePlayer(me, s); });
    wirePlay();
  } else {
    watchSettings(fillTarget);
    initLogin();
  }

  // ---------------- přehled ----------------
  function render(me: Player, s: Settings) {
    const t = Number(s.target) || 100, left = Math.max(0, t - me.points);
    $('sumHead').textContent = left ? `Ještě ${fmt(left)} ${bodu(left)} do cíle` : 'Cíl splněn!';
    $('sumLead').textContent = left
      ? `Máš ${fmt(me.points)} z ${fmt(t)} bodů.`
      : `Máš ${fmt(me.points)} bodů. Ukaž tuhle obrazovku u stolu organizátorů. Hrát můžeš dál.`;
    setRing($('bigRing'), me.points, t);

    const maxPer = Math.max(...GAMES.map((g) => g.maxPoints)) * 2;
    for (const g of GAMES) {
      const gp = me.games?.[g.id]?.points || 0;
      const li = document.querySelector(`[data-break="${g.id}"]`)!;
      li.querySelector('.b-val')!.textContent = fmt(gp);
      (li.querySelector('.b-fill') as HTMLElement).style.width = `${Math.min(100, (gp / maxPer) * 100)}%`;
      const mine = document.querySelector(`[data-game="${g.id}"] [data-mine]`) as HTMLElement;
      mine.textContent = gp ? `Máš tu ${fmt(gp)} b` : 'Zatím 0 b';
      mine.classList.toggle('has', !!gp);
    }

    // doporuč hru, kde má hráč nejmíň bodů
    const next = [...GAMES].sort((a, b) => (me.games?.[a.id]?.points || 0) - (me.games?.[b.id]?.points || 0))[0];
    const btn = $<HTMLAnchorElement>('nextGame');
    btn.href = `/hra/${next.id}/`;
    btn.dataset.play = next.id;
    $('nextLabel').textContent = `Hrát ${next.title}`;
  }

  // hra se otevře v této stránce, aby šla hned celá obrazovka (prohlížeč ji povolí jen při kliknutí)
  function wirePlay() {
    initPlayer();
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-play]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || (e as MouseEvent).button) return;
      e.preventDefault();
      openGame(a.dataset.play!, { push: true });
    });
  }

  // ---------------- přihlášení ----------------
  function initLogin() {
    const input = $<HTMLInputElement>('nameInput');
    const hint = (text: string, err = false) => {
      $('nameHint').textContent = text;
      $('nameHint').classList.toggle('is-error', err);
      input.setAttribute('aria-invalid', String(err));
    };
    try {
      const bye = sessionStorage.getItem('dodhry:bye');
      if (bye) { $('bye').textContent = bye; $('bye').hidden = false; sessionStorage.removeItem('dodhry:bye'); }
    } catch {}
    input.focus();
    input.addEventListener('input', () => { hint(''); $('suggest').hidden = true; });

    let pending = '';
    const enter = (p: Player) => { setSession(p.key); location.reload(); };

    $('nameForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = cleanName(input.value);
      if (nameKey(name).length < 2) return hint('Napiš aspoň dvě písmena nebo číslice.', true);
      if (isBadName(name)) return hint('Tohle jméno tu použít nejde. Vyber si prosím jiné.', true);
      const go = $<HTMLButtonElement>('nameGo');
      go.disabled = true;
      try {
        const existing = await getPlayer(nameKey(name));
        if (existing) return conflict(name, existing);
        const created = await createPlayer(name);
        if (created) return enter(created);
        conflict(name, (await getPlayer(nameKey(name)))!);
      } catch (err) {
        console.error(err);
        hint('Nepodařilo se spojit s databází. Zkontroluj připojení a zkus to znovu.', true);
      } finally {
        go.disabled = false;
      }
    });

    function conflict(name: string, p: Player) {
      pending = name;
      $('nameForm').hidden = true;
      $('conflict').hidden = false;
      $('cName').textContent = p.name;
      $('cName2').textContent = p.name;
      $('cPts').textContent = fmt(p.points);
      setRing($('cRing'), p.points, target);
      $('cMe').onclick = () => enter(p);
      $('cMe').focus();
    }

    $('cNew').addEventListener('click', async () => {
      $('conflict').hidden = true;
      $('nameForm').hidden = false;
      input.value = pending;
      hint('Tohle jméno už má někdo jiný. Přidej k němu třeba třídu nebo příjmení.', true);
      input.focus();
      input.select();
      const ideas = [`${pending} ${new Date().getFullYear() % 100}`, `${pending} 2`, `${pending} ${10 + Math.floor(Math.random() * 89)}`];
      const free: string[] = [];
      for (const o of ideas) if (!free.includes(o) && !(await getPlayer(nameKey(o)))) free.push(o);
      const box = $('suggest');
      box.innerHTML = free.map((o) => `<button type="button" class="chip">${esc(o)}</button>`).join('');
      box.hidden = !free.length;
      box.querySelectorAll('button').forEach((b) => (b.onclick = () => { input.value = b.textContent!; $<HTMLFormElement>('nameForm').requestSubmit(); }));
    });
  }
</script>
