---
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import { GAMES, type Game } from '../../lib/games';

export function getStaticPaths() {
  return GAMES.map((g) => ({ params: { id: g.id }, props: { game: g } }));
}
const { game } = Astro.props as { game: Game };
---
<Base title={`${game.title} · DOD hry`}>
  <Player gameId={game.id} />
</Base>

<script>
  import { requirePlayer } from '../../lib/session';
  import { initPlayer, updatePlayer } from '../../lib/player';
  initPlayer({ standalone: true });
  requirePlayer(updatePlayer);
</script>
